rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && userDoc().data.role == 'ADMIN'
        && userDoc().data.approvalStatus == 'APPROVED';
    }

    function isTrainer() {
      return signedIn()
        && userDoc().data.role == 'TRAINER'
        && userDoc().data.approvalStatus == 'APPROVED';
    }

    function isTrainee() {
      return signedIn()
        && userDoc().data.role == 'TRAINEE'
        && userDoc().data.approvalStatus == 'APPROVED';
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // Signed-in users can read profiles.
      // We will refine public/private profile visibility later.
      allow read: if signedIn();

      // A newly authenticated user may create ONLY their own profile.
      //
      // The client cannot create an ADMIN account.
      // New TRAINER/TRAINEE accounts start as PENDING.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['TRAINER', 'TRAINEE']
        && request.resource.data.approvalStatus == 'PENDING';

      // A user can update their own profile, but cannot change:
      // - role
      // - approvalStatus
      // - uid
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'role',
            'approvalStatus',
            'uid'
          ]);

      // Approved ADMIN can update another user's privileged fields.
      //
      // This is intentionally restricted to users other than themselves.
      allow update: if isAdmin()
        && request.auth.uid != uid;

      // No client-side user deletion.
      allow delete: if false;
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {

      // Published courses can be browsed by signed-in users.
      //
      // ADMIN can read everything.
      // TRAINER can read everything for now so existing trainer
      // management screens continue to work.
      allow read: if signedIn()
        && (
          isAdmin()
          || isTrainer()
          || (
            resource.data.status == 'published'
            && (
              userDoc().data.role == 'TRAINEE'
              && userDoc().data.approvalStatus == 'APPROVED'
            )
          )
        );

      // Approved trainer creates their own course.
      //
      // trainerId MUST belong to the authenticated trainer.
      allow create: if isTrainer()
        && request.resource.data.trainerId == request.auth.uid;

      // Approved trainer may update ONLY their own course.
      //
      // Ownership cannot be transferred.
      allow update: if isTrainer()
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;

      // Trainer may delete only their own course.
      allow delete: if isTrainer()
        && resource.data.trainerId == request.auth.uid;

      // ADMIN can manage courses.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // ENROLLMENTS
    // ============================================================

    match /enrollments/{enrollmentId} {

      // ADMIN can read all enrollments.
      allow read: if isAdmin();

      // Approved TRAINEE can read their own enrollment.
      allow read: if isTrainee()
        && resource.data.traineeId == request.auth.uid;

      // Approved TRAINER (course owner) can read enrollments only for courses
      // they own. Enrollment documents carry `trainerId` (the owning trainer's
      // account id), so a trainer can never read another trainer's enrollment
      // records or the certificates they carry.
      allow read: if isTrainer()
        && resource.data.trainerId == request.auth.uid;

      // Approved trainee can create an enrollment for themselves.
      allow create: if isTrainee()
        && request.resource.data.traineeId == request.auth.uid;

      // Trainees can update only their own enrollment.
      //
      // We will later restrict which fields they can change
      // once course-progress structure is confirmed.
      allow update: if isTrainee()
        && resource.data.traineeId == request.auth.uid
        && request.resource.data.traineeId == request.auth.uid;

      // No trainee-side deletion.
      allow delete: if false;

      // ADMIN can manage enrollments.
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    // Anything not explicitly defined above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}