# ---------------------------------------------------------------------------
# CAPACITY CONNECT — Backend environment configuration
# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill in the real values.
# server/.env is git-ignored and must NEVER be committed.
#
# The backend uses two Supabase credentials:
#   1. SUPABASE_ANON_KEY         — public/client-safe key (may be known to client)
#   2. SUPABASE_SERVICE_ROLE_KEY — SERVER-ONLY privileged key
# The service-role key bypasses Row Level Security. It must NEVER be:
#   - exposed in any API response
#   - used in the React frontend
#   - prefixed with VITE_
#   - committed to version control

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed browser origin for CORS (the React frontend).
# Production example: https://capacity-connect.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# HTTP port the API listens on (default 5000)
PORT=5000

# development | test | production
NODE_ENV=development