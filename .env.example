# CAPACITY CONNECT — Frontend / Cloud configuration
#
# The application no longer uses Firebase (no Firebase Auth, Firestore or
# Firebase Storage). Authentication and all persistent data are handled by the
# Node/Express backend through Supabase Auth + PostgreSQL + Storage. See
# server/.env.example for backend credentials.
#
# Cloudinary remains only as the legacy browser-upload path for profile photos
# in the dev-mock mode; real users upload through the backend.
#

# ---------------------------------------------------------------------------
# Backend API (Node.js + Express + Supabase Auth)
# ---------------------------------------------------------------------------
# Base URL of the running backend — the ORIGIN only, e.g. http://localhost:5000.
# Do NOT include the '/api' mount point: the API client appends '/api' itself,
# so requests always reach /api/auth/*, /api/users/*, /api/health. If a trailing
# '/api' is configured anyway the client normalises it away (no '/api/api').
# The frontend never talks to Supabase directly for authentication — all
# register / login / logout / /me requests go through this URL.
VITE_API_BASE_URL=http://localhost:5000

# Dev-only convenience: when the backend is unreachable (e.g. server/.env
# has not been created yet) a small in-memory mock login lets the four seed
# accounts sign in so the UI remains runnable for demos and local dev.
# Set to "false" to force all local logins through the real backend.
VITE_DEV_MOCK_AUTH=true

# DEV-only demo-data toggle: with VITE_DEMO_MODE=true, the READ-ONLY
# demonstration surfaces (regional heatmap, admin dashboard figures, officer
# dispatch, trainer matching, seeded broadcasts/notifications, seed profile
# lookups) render the seeded demo dataset even when signed in with a REAL
# Supabase account, so demos look fully populated.
# It NEVER affects authentication and NEVER reroutes writes — a real user's
# actions always hit the real backend. Inert in production builds.
VITE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Cloudinary configuration (unsigned browser uploads, legacy dev-mock path)
# ---------------------------------------------------------------------------
# These enable direct-to-Cloudinary uploads for the dev-mock fallback. Create a
# cloud name + an unsigned upload preset (Settings → Upload → Add upload preset
# → Signing mode: Unsigned). Configure the preset to restrict allowed file
# types/sizes as desired.
#
# IMPORTANT: NEVER put your Cloudinary API Secret in frontend env vars.
# The API Secret is only needed for server-side/Admin SDK operations. The browser
# uses only the unsigned upload preset — no signing secrets are exposed.
#
# IMPORTANT (PDF delivery): Cloudinary blocks delivery of PDF/ZIP files by
# default for security (the delivery URL returns 401 with
# `x-cld-error: deny or ACL failure` and the in-app PDF viewer shows
# "Failed to load PDF document" — this is a Cloudinary-side setting, NOT an app
# bug). To allow PDF preview/download, enable it in the Cloudinary Console:
#   Settings → Security → "PDF and ZIP files delivery" → allow delivery.
# Non-PDF files (slides, images, videos) are unaffected.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=