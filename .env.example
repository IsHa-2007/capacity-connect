# CAPACITY CONNECT — Firebase configuration
# Copy to .env and fill in your Firebase project values to connect the real
# backend (Firebase Auth + Cloud Firestore). Until these are set, the app runs
# against an isolated in-memory development mock that is NOT the production
# source of truth.
#
# AFTER SETTING UP .env:
#   1. Enable Email/Password sign-in in Firebase Console → Authentication → Sign-in method
#   2. Run `node scripts/provision-admin.mjs` to create the first admin account
#      (requires serviceAccount.json — see scripts/provision-admin.mjs for details)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to "true" to use the Firestore emulator on localhost:8080
VITE_FIREBASE_USE_EMULATOR=false

# ---------------------------------------------------------------------------
# Cloudinary configuration (unsigned browser uploads)
# ---------------------------------------------------------------------------
# These enable direct-to-Cloudinary uploads. Create a cloud name + an unsigned
# upload preset (Settings → Upload → Add upload preset → Signing mode: Unsigned).
# Configure the preset to restrict allowed file types/sizes as desired.
#
# IMPORTANT: NEVER put your Cloudinary API Secret in frontend env vars.
# The API Secret is only needed for server-side/Admin SDK operations. The browser
# uses only the unsigned upload preset — no signing secrets are exposed.
#
# IMPORTANT (PDF delivery): Cloudinary blocks delivery of PDF/ZIP files by
# default for security (the delivery URL returns 401 with
# `x-cld-error: deny or ACL failure` and the in-app PDF viewer shows
# "Failed to load PDF document" — this is a Cloudinary-side setting, NOT an app
# bug). To allow PDF preview/download, enable it in the Cloudinary Console:
#   Settings → Security → "PDF and ZIP files delivery" → allow delivery.
# Non-PDF files (slides, images, videos) are unaffected.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
